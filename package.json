{
  "name": "styled-atom",
  "author": "Georg Schilin",
  "version": "4.0.0",
  "private": true,
  "description": "Atomic CSS-in-JS compiler and style lifecycle runtime for dynamic UI surfaces",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.cts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/esm/react.d.ts"
      ],
      "*": [
        "./dist/esm/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts --host 127.0.0.1",
    "example:build": "vite build --config example/vite.config.ts",
    "build": "rollup -c && node scripts/write-markers.mjs",
    "prepublishOnly": "node scripts/block-root-publish.mjs",
    "package-prepare": "npm run typecheck && npm run test && npm run build && node scripts/smoke-dist.mjs && node scripts/prepare-publish.mjs",
    "publish:dry": "npm run package-prepare && cd publish && npm pack --dry-run",
    "publish": "npm run package-prepare && npm publish ./publish --access public",
    "release:check": "npm run lint && npm run site:check && npm run package-prepare && npm run example:build && npm run site:build && cd publish && npm pack --dry-run",
    "lint": "eslint src test site/src example/src scripts rollup.config.js eslint.config.js vitest.config.ts site/vite.config.ts example/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "site": "vite --config site/vite.config.ts",
    "site:check": "tsc -p site/tsconfig.json --noEmit",
    "site:build": "vite build --config site/vite.config.ts --base=/styled-atom/",
    "site:preview": "vite preview --config site/vite.config.ts --base=/styled-atom/",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "keywords": [
    "react",
    "css",
    "styles",
    "runtime",
    "dynamic-css",
    "style-loader",
    "css-loader",
    "css-in-js",
    "styled-atom"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.3",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voodoofugu/styled-atom.git"
  },
  "homepage": "https://voodoofugu.github.io/styled-atom/",
  "bugs": {
    "url": "https://github.com/voodoofugu/styled-atom/issues"
  }
}
